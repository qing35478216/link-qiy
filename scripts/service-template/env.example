# LinkAI __SERVICE_NAME__ 服务环境变量样例（复制为 .env 使用，.env 不入库）
SERVICE_NAME=__SERVICE_NAME__
PORT=8000
LOG_LEVEL=info

# 依赖栈连接（docker-compose 默认值）
DATABASE_URL=postgresql+psycopg://linkai:linkai_dev_password@localhost:5432/linkai
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=linkai-__SERVICE_NAME__
S3_ACCESS_KEY=linkai
S3_SECRET_KEY=linkai_dev_password

# OTel（Jaeger/OTLP Collector 落地后指向真实地址；off 时仍打印 trace_id 到结构化日志）
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=linkai-__SERVICE_NAME__
