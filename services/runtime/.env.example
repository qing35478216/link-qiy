# LinkAI runtime 服务环境变量样例（复制为 .env 使用，.env 不入库）
SERVICE_NAME=runtime
PORT=8010
LOG_LEVEL=info

# 依赖栈连接（docker-compose 默认值）
DATABASE_URL=postgresql+psycopg://linkai:linkai_dev_password@localhost:5432/linkai

# model-proxy（下游）：OpenAI 兼容端点。生产经 gateway 内网域名注入。
LINKAI_MODEL_PROXY_URL=http://localhost:8000
# platform（上游）：应用设定来源（当前为 console 端点，服务间端点未就绪=技术债）。
LINKAI_PLATFORM_URL=http://localhost:8002
# 服务间调用 platform 的令牌（platform 内部端点就绪后启用；空 = 不带）
LINKAI_SERVICE_TOKEN=

# 应用设定来源：static（Phase 0 默认，env 注入）| platform（HTTP 拉取）
LINKAI_APP_PROFILE_SOURCE=static
# static 源应用设定 JSON：{ "appCode": { ...platform AppConfigOut 同构... } }
# 示例（单行 JSON，勿换行）：
# LINKAI_STATIC_APP_PROFILES={"demo":{"modelPrompt":{"modelCode":"deepseek-chat","systemPrompt":"你是{{role}}助手","temperature":0.7,"memoryRounds":5,"contextLength":4096,"variables":[{"name":"role","value":"客服"}]}}}

# Phase 0 开发用 API Key 种子："key:tenant[:user],key:tenant[:user]"
# 仅开发/联调；生产由 platform Key 签发体系供给（技术债见 README）
LINKAI_DEV_API_KEYS=sk-linkai-dev-001:t-001:u-001

# 配额守卫（Phase 0 内存）：每租户每日 token 上限（"tenant:tokens" 覆盖默认）
LINKAI_QUOTA_DEFAULT_DAILY_TOKENS=1000000
LINKAI_QUOTA_TENANT_DAILY_TOKENS=

# 出网超时（秒）：模型流式读超时需放宽
LINKAI_HTTP_TIMEOUT_SECONDS=120
LINKAI_HTTP_CONNECT_TIMEOUT_SECONDS=5

# OTel（Jaeger/OTLP Collector 落地后指向真实地址；off 时仍打印 trace_id 到结构化日志）
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=linkai-runtime
