# LinkAI billing 服务环境变量样例（复制为 .env 使用，.env 不入库）
SERVICE_NAME=billing
PORT=8010
LOG_LEVEL=info

# 依赖栈连接（docker-compose 默认值）
DATABASE_URL=postgresql+psycopg://linkai:linkai_dev_password@localhost:5432/linkai

# 计量事件流水（Redis Streams）。为空 = 内存实现（单进程 dev/测试）；
# 多实例部署必须配置，否则各实例流水不互通、对账口径不全。
REDIS_URL=redis://localhost:6379/0

# —— 资金域密钥（生产必须注入；默认值仅本地开发，启动打警告）——
# 与 platform 共享的 JWT 密钥（billing 只校验不签发）
LINKAI_JWT_SECRET=dev-only-insecure-secret-change-me
# 服务间内部 API 凭据（metering 消费 / plan 同步 / 对账触发 / 支付回调）
LINKAI_INTERNAL_TOKEN=dev-only-insecure-internal-token
# Mock 支付渠道回调 HMAC 签名密钥（生产换真实渠道适配器）
LINKAI_PAYMENT_MOCK_SECRET=dev-only-insecure-payment-secret

# OTel（Jaeger/OTLP Collector 落地后指向真实地址；off 时仍打印 trace_id 到结构化日志）
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=linkai-billing
