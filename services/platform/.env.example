# LinkAI platform 服务环境变量样例（复制为 .env 使用，.env 不入库）
SERVICE_NAME=platform
PORT=8000
LOG_LEVEL=info

# 依赖栈连接（docker-compose 默认值）
DATABASE_URL=postgresql+psycopg://linkai:linkai_dev_password@localhost:5432/linkai
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=linkai-platform
S3_ACCESS_KEY=linkai
S3_SECRET_KEY=linkai_dev_password

# OTel（Jaeger/OTLP Collector 落地后指向真实地址；off 时仍打印 trace_id 到结构化日志）
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=linkai-platform

# —— 账户域（T-002）——
# JWT 密钥：生产必须注入强随机值；默认值仅本地开发可用，启动时会打警告日志
LINKAI_JWT_SECRET=dev-only-insecure-secret-change-me
LINKAI_ACCESS_TOKEN_TTL_SECONDS=3600
LINKAI_REFRESH_TOKEN_TTL_SECONDS=2592000
# 短信验证码有效期（秒）
LINKAI_SMS_CODE_TTL_SECONDS=300
# Mock 微信扫码：自动确认延迟（秒）；<=0 表示不自动确认（仅联调/测试设小值）
LINKAI_WECHAT_MOCK_AUTO_CONFIRM_SECONDS=0
